# ─── App ─────────────────────────────────────────
APP_NAME="Groupe Scolaire Privé Bilingue Les Jumelles"
APP_ENV=production
APP_KEY=base64:paHWI17YKKjL7Ni6EngNuJZsJ3xW5dwSHQT8DVjyA2I=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database (must match docker-compose.yml) ────
# IMPORTANT: Change DB_PASSWORD before deploying!
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=school
DB_USERNAME=school_user
DB_PASSWORD=ChangeMe_StrongPassword!2024

# ─── Session / Cache / Queue ──────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Broadcast ────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# ─── Mail ─────────────────────────────────────────
# IMPORTANT: Replace with your real SMTP credentials
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_hkGTV8wP_CGfJWDMvcTTsLQpevV82NHGD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreplay@briefurl.app"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ─────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# ─── GeoIP ───────────────────────────────────────
GEOIP_SERVICE=ip_api
GEOIP_IPAPI_SECURE=true
