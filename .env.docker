# ─── App ─────────────────────────────────────────
APP_NAME="Groupe Scolaire Privé Bilingue Les Jumelles"
APP_ENV=production
APP_KEY=base64:+XdJYyLP6Dy6Wq8k8tZL5HDoZ2IbzA5ayawBJY8ub+w=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

# ─── Database (must match docker-compose.yml) ───
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=school
DB_USERNAME=school_user
DB_PASSWORD=school_pass

# ─── Session / Cache / Queue ──────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Mail ─────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@lesjumelles.sn"
MAIL_FROM_NAME="Les Jumelles"

# ─── Filesystem ───────────────────────────────────
FILESYSTEM_DISK=public

# ─── GeoIP ───────────────────────────────────────
GEOIP_SERVICE=ip_api
GEOIP_IPAPI_SECURE=true
